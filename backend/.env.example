# Backend host-side dev — copy to repo root .env:  cp .env.example .env
# backend/.env should symlink to ../.env (see backend/README.md).
# Loaded by app/settings.py when running API on the host (alembic, pytest, run.py).
#
# Docker full stack: use repo root .env + npm start instead of duplicating values here.

HF_HUB_OFFLINE=1

# --- Required ---
DATABASE_URL=postgresql://ragsuite:ragsuite@localhost:5436/ragsuite_v3
JWT_SECRET_KEY=change-me-use-a-long-random-secret-in-production
CUSTOM_LLM_INTERNAL_API_KEY=change-me-generate-a-strong-random-key

# --- Required: transactional email (invites, 2FA, password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=change-me-app-password-or-smtp-secret
SMTP_USE_TLS=true
EMAIL_FROM=your-smtp-user@example.com

# --- Core ---
DEBUG=False
CORS_ORIGINS=http://localhost:9091
FRONTEND_BASE_URL=http://localhost:9091
PUBLIC_API_BASE_URL=http://localhost:9090/api/v1

# --- SSO (optional) ---
SSO_ENABLED=false
SSO_CALLBACK_BASE_URL=http://localhost:9090/api/v1/auth/sso/callback
SSO_REQUIRE_REDIS=true

# --- Redis (compose publishes :6382 on host; container-internal port is 6379) ---
REDIS_HOST=localhost
REDIS_PORT=6382
# REDIS_URL=  # optional full URL override (takes priority over HOST/PORT)

# --- Workers ---
ENABLE_DURABLE_JOBS=true
ENABLE_ASYNC_DOCUMENT_INGEST=true
DOCUMENT_STAGING_DIR=data/staging
RUN_INLINE_WORKER=true
EMBEDDING_PREFERRED_SOURCE=chat
COMPARE_MODEL_CONFIG_SOURCE=chat

# --- Chroma (host-side only; compose stack sets chromadb:8000 internally) ---
CHROMA_MODE=http
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8004
CHROMA_SSL=false
CHROMA_PERSIST_PATH=data/chroma_db

# --- Ollama (local embeddings / LLM) ---
OLLAMA_BASE_URL=http://localhost:11434

# Advanced tuning: docs/backend/configuration.md
