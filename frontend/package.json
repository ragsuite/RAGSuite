{
  "name": "ragsuite",
  "main": "index",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start --port 9191",
    "env:local": "cp envs/local.json env.json",
    "env:containerized": "cp envs/containerized.json env.json",
    "env:staging": "cp envs/staging.json env.json",
    "env:production": "cp envs/production.json env.json",
    "ios:pods": "bash ../scripts/ensure-ios-pods.sh",
    "ios": "bash ../scripts/ensure-ios-pods.sh && expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web --port 9191",
    "reset-project": "node ./scripts/reset-project.js",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "sync-i18n": "node scripts/sync-i18n-locales.mjs",
    "sync-widget-assets": "node scripts/sync-widget-assets.mjs",
    "patch-widget-brand": "node scripts/patch-widget-brand-css.mjs && npm run sync-widget-assets",
    "check-i18n": "node scripts/check-i18n-keys.mjs",
    "check-action-icons": "node scripts/check-action-icons.mjs",
    "test": "jest",
    "postinstall": "setup-skia-web && node ./scripts/patch-react-navigation-pointer-events.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
