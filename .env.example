# RAGSuite Server — copy to .env:  cp .env.example .env

# --- Required secrets ---
# JWT is regenerated by `ragsuite init` (do not put real secrets here — use .env).
JWT_SECRET_KEY=change-me-use-a-long-random-secret-in-production
# First-run default (not a cloud vendor key). Override in .env anytime.
CUSTOM_LLM_INTERNAL_API_KEY=ragsuite-default-llm-internal-key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=change-me-app-password-or-smtp-secret
SMTP_USE_TLS=true
EMAIL_FROM=your-smtp-user@example.com

# --- Frontend Docker build (baked into env.json at image build) ---
FRONTEND_API_URL=http://localhost:9090

# CORS_ORIGINS=https://rag.tenant-a.example.com,https://staging.example.com

DEBUG=True
HF_HUB_OFFLINE=1
SSO_ENABLED=false
SSO_REQUIRE_REDIS=true

# --- RAG / ingest (optional) ---
ENABLE_ASYNC_DOCUMENT_INGEST=true
EMBEDDING_PREFERRED_SOURCE=chat
COMPARE_MODEL_CONFIG_SOURCE=chat

# --- Optional: Ollama as seen from the Docker backend/worker (default: host Ollama) ---
# Native `npm start` uses OLLAMA_BASE_URL (default http://localhost:11434) instead.
# OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434

# --- Optional: Compose Postgres credentials (defaults: ragsuite / ragsuite / ragsuite_v3) ---
# POSTGRES_USER=ragsuite
# POSTGRES_PASSWORD=ragsuite
# POSTGRES_DB=ragsuite_v3

# --- Optional: App URL / CORS (compose sets local defaults for Docker) ---
# CORS_ORIGINS=http://localhost:9191
# FRONTEND_BASE_URL=http://localhost:9191
# PUBLIC_API_BASE_URL=http://localhost:9090/api/v1
# SSO callback must be the public API origin (not a request Host / X-Forwarded-Host).
# For ngrok/tunnels set this to the tunnel URL, e.g. https://<id>.ngrok-free.dev/api/v1/auth/sso/callback
# SSO_CALLBACK_BASE_URL=http://localhost:9090/api/v1/auth/sso/callback

# --- Elasticsearch (primary retrieve) + MinIO-compatible object store (blobs) ---
# Required in .env (compose has no in-file defaults). `npm start` generates values
# only when it creates a new .env. Existing ES/MinIO volumes keep the password they
# were created with — if you used older local defaults, set:
#   ELASTICSEARCH_PASSWORD=ragsuite
#   MINIO_ACCESS_KEY=ragsuite
#   MINIO_SECRET_KEY=ragsuite-minio-secret
# Docker compose sets these for backend/worker. Native npm start uses the host ports below.
# Compose image is pgsty/silo (S3 API); official minio/minio is no longer publicly pullable.
# ELASTICSEARCH_URL=http://localhost:9210
# ELASTICSEARCH_USER=elastic
# ELASTICSEARCH_PASSWORD=
# MINIO_ENDPOINT=localhost:9010
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=ragsuite
# MINIO_SECURE=false
# API_REPLICAS=2
# WORKER_REPLICAS=2
# CRAWL_WORKER_REPLICAS=1
# Native worker handles every role. Docker splits index vs crawl.
# WORKER_ROLES=all
# ES_JAVA_OPTS=-Xms512m -Xmx512m
# Hosted Linux: sudo sysctl -w vm.max_map_count=262144

# --- Docker EE attach (sibling DX — required for raw `docker compose up`) ---
# RAGSUITE_EE_ROOT=/absolute/path/to/RAGSUITE_EE
# RAGSUITE_EE_DOCKER_CONTEXT=/absolute/path/to/RAGSUITE_EE